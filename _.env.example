# Copia este archivo a .env (no se sube a git).

# Supabase: clave PUBLICABLE (sb_publishable_...). Nunca la clave secreta.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Backend. Déjalo vacío en desarrollo: Vite reenvía /api a VITE_DEV_API_TARGET.
# En producción, si el backend está en otro dominio, pon aquí su URL (ej. https://api.ejemplo.edu.co);
# el backend debe tener ese dominio del frontend en su ALLOWED_ORIGIN.
VITE_API_URL=
VITE_DEV_API_TARGET=http://localhost:3001
